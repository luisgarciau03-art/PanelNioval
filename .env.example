# Variables de entorno de PanelNioval (sin valores reales — cargarlas en Railway / PC del owner).
# NUNCA commitear los valores. .gitignore ya ignora .env y .env.*

# --- Panel (Railway) ---
GOOGLE_CREDENTIALS_JSON=      # JSON del service account de Google (una sola línea)
SECRET_KEY=                   # clave de sesión Flask FIJA (aleatoria ≥32 chars). Obligatoria si activas PANEL_DASHBOARD_TOKEN
PANEL_DASHBOARD_TOKEN=        # (opcional, M1) si se define, el panel exige el token. Automatización: header X-Dashboard-Token (evita el ?token= en logs/historial)
GMAPS_API_KEY=                # Google Places (importador). ROTAR la key expuesta antes de usar.

# --- Telegram (reportes) ---
TELEGRAM_TOKEN=               # ROTAR el bot 8404009072 (expuesto en el historial) antes del go-live
TELEGRAM_CHAT_ID=

# --- Worker local de catálogo (transporte B, PC del owner) ---
PANEL_URL=                    # URL de Railway, para el heartbeat del worker
WORKER_TOKEN=                 # (opcional) protege el heartbeat. Actívalo JUNTO con PANEL_DASHBOARD_TOKEN
                              # (si activas el token del panel sin este, el heartbeat queda abierto)
# Gate de seguridad de envío: el worker NO envía nada sin autorización.
WA_ENVIO_PASSWORD=            # contraseña de envío (ej. una contraseña fuerte (mín 12 chars)). Sin ella, el worker no envía.
WA_ENVIO_ARMADO=             # =1 para autorizar corridas NO interactivas (Tarea Programada).
                              # En corrida manual (terminal), el worker SOLICITA la contraseña.
